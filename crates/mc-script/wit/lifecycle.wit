// The phases of a plugin instance and the startup rule plan.
//
// A plugin instance moves through exactly these phases: `configure` once in a
// short-lived store with no runtime capability, then `init` once in its runtime
// store, then any number of `on-events` calls, then `shutdown` when the host
// retires the instance. Startup rules are a pure function of the package
// configuration: the same configuration must produce the same plan, because the
// resolved plan is fingerprinted into the world contract.
interface lifecycle {
    use types.{plugin-error};
    use commands.{command};

    /// Village and terrain placement rules, the WASM form of the retired
    /// `rules.lua` plan. Every category is optional; a plan must set at least
    /// one, and the host validates every bound before the plan is materialized.
    record placement-rules {
        /// Candidate separation for land placements, 1..4.
        land-spacing: u32,
        /// Candidate columns tried for a water placement, 1..32.
        water-attempts: u32,
        /// How far below the chosen column's water surface to look, 1..16.
        water-depth: u32,
    }

    record tree-rules {
        /// Biomes this declaration covers, 1..64 names.
        biomes: list<string>,
        /// Positive deterministic candidate divisor, not a distance.
        spacing: u32,
        /// Finite value in -1..1.
        density-threshold: f64,
    }

    record clay-rules {
        /// Positive candidate divisor.
        rarity: u32,
        /// Disk radius bounds, 1 <= min <= max <= 3.
        radius-min: u32,
        radius-max: u32,
        /// Water depth bound, 1..32.
        max-water-depth: u32,
    }

    /// One spawn group replacement for one biome.
    record spawn-group {
        /// `creature`, `monster`, `water_ambient` or `water_creature`.
        group: string,
        /// At most 32 entries.
        entries: list<spawn-entry>,
    }

    record spawn-entry {
        entity: string,
        /// 1 <= min <= max <= 6.
        min: u32,
        max: u32,
        /// 1..10000.
        weight: u32,
    }

    record spawn-rules {
        biome: string,
        /// At most four groups; a listed group replaces its biome's groups.
        groups: list<spawn-group>,
    }

    /// The normalized startup plan. Only the categories the package sets are
    /// present; the host rejects a plan that sets none.
    record rule-plan {
        placement: option<placement-rules>,
        /// At most 64 declarations.
        trees: option<list<tree-rules>>,
        clay: option<clay-rules>,
        /// At most 64 biomes.
        spawning: option<list<spawn-rules>>,
    }

    /// Values the host fixes for the instance, independent of the package.
    record init-context {
        /// The plugin id the host bound to this instance.
        plugin-id: string,
        /// The contract version this instance was instantiated against.
        api-version: string,
        /// The world contract fingerprint the running world was opened with, or
        /// the empty string when the server runs before a world is chosen.
        world-fingerprint: string,
    }

    /// Startup phase. `config` is the package's `config.toml` text - the host
    /// does not interpret it, and the guest SDK parses it. The returned plan is
    /// the only thing this phase may produce; there is no world or runtime
    /// access here.
    configure: func(config: string) -> result<option<rule-plan>, plugin-error>;

    /// Runtime phase. Answers the commands that must be applied before the
    /// instance receives events, e.g. registering what it owns. Called exactly
    /// once per instance.
    init: func(config: string, context: init-context) -> result<list<command>, plugin-error>;

    /// Best-effort cleanup before the host retires the instance. The host
    /// reclaims what it owns regardless of what this call returns, and a
    /// crash does not run it at all, so no durable decision may depend on it.
    shutdown: func() -> result<_, plugin-error>;
}
