// The phases of a plugin instance and the startup contribution.
//
// A plugin instance moves through exactly these phases: `configure` once in a
// short-lived store with no runtime capability, then `init` once in its runtime
// store, then any number of `on-events` calls, then `shutdown` when the host
// retires the instance. Startup rules are a pure function of the package
// configuration: the same configuration must produce the same contribution,
// because the resolved rules are fingerprinted into the world contract.
interface lifecycle {
    use types.{plugin-error};
    use commands.{command};

    /// Village and terrain placement rules declared by a component. Every
    /// category is optional; a contribution must set at least one, and the host
    /// validates every bound before the rules are materialized.
    record placement-rules {
        /// Candidate separation for land placements, 1..4.
        land-spacing: u32,
        /// Candidate columns tried for a water placement, 1..32.
        water-attempts: u32,
        /// How far below the chosen column's water surface to look, 1..16.
        water-depth: u32,
    }

    record tree-rules {
        /// Biomes this declaration covers, 1..64 names.
        biomes: list<string>,
        /// Positive deterministic candidate divisor, not a distance.
        spacing: u32,
        /// Finite value in -1..1.
        density-threshold: f64,
    }

    record clay-rules {
        /// Positive candidate divisor.
        rarity: u32,
        /// Disk radius bounds, 1 <= min <= max <= 3.
        radius-min: u32,
        radius-max: u32,
        /// Water depth bound, 1..32.
        max-water-depth: u32,
    }

    /// One spawn group replacement for one biome.
    record spawn-group {
        /// `creature`, `monster`, `water_ambient` or `water_creature`.
        group: string,
        /// At most 32 entries.
        entries: list<spawn-entry>,
    }

    record spawn-entry {
        entity: string,
        /// 1 <= min <= max <= 6.
        min: u32,
        max: u32,
        /// 1..10000.
        weight: u32,
    }

    record spawn-rules {
        biome: string,
        /// At most four groups; a listed group replaces its biome's groups.
        groups: list<spawn-group>,
    }

    /// Canonical server identity and the vanilla packet carrier for one item.
    /// The carrier is presentation only: gameplay uses the declaration below.
    record item-definition {
        id: string,
        carrier: string,
        name: string,
        max-stack-size: u32,
        max-damage: option<u32>,
        weapon: bool,
        attack-damage-modifier: option<f32>,
        attack-speed-modifier: option<f32>,
        equippable-slot: option<string>,
        /// An optional one-input shapeless recipe (vanilla or owned item id).
        crafting-ingredient: option<string>,
    }

    /// The normalized startup contribution. Only the categories the package sets
    /// are present; the host rejects a contribution that sets none.
    record startup-contribution {
        placement: option<placement-rules>,
        /// At most 64 declarations.
        trees: option<list<tree-rules>>,
        clay: option<clay-rules>,
        /// At most 64 biomes.
        spawning: option<list<spawn-rules>>,
        /// At most 16 identities owned by this plugin. The host checks that
        /// their matching Loader bundle declared `register_items` before use.
        items: option<list<item-definition>>,
    }

    /// Values the host fixes for the instance, independent of the package.
    record init-context {
        /// The plugin id the host bound to this instance.
        plugin-id: string,
        /// The contract version this instance was instantiated against.
        api-version: string,
        /// The world contract fingerprint the running world was opened with, or
        /// the empty string when the server runs before a world is chosen.
        world-fingerprint: string,
    }

    /// Startup phase. `config` is the package's `config.toml` text - the host
    /// does not interpret it, and the guest SDK parses it. The returned
    /// contribution is the only thing this phase may produce; there is no world or
    /// runtime access here, and the store this runs in is dropped before the
    /// runtime store `init` runs in exists.
    configure: func(config: string) -> result<option<startup-contribution>, plugin-error>;

    /// Runtime phase. Answers the commands that must be applied before the
    /// instance receives events, e.g. registering what it owns. Called exactly
    /// once per instance.
    init: func(config: string, context: init-context) -> result<list<command>, plugin-error>;

    /// Best-effort cleanup before the host retires the instance. The host
    /// reclaims what it owns regardless of what this call returns, and a
    /// crash does not run it at all, so no durable decision may depend on it.
    shutdown: func() -> result<_, plugin-error>;
}
