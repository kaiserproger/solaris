// Commands a plugin asks the host to perform.
//
// A command is a request, never an effect: the host validates the whole batch a
// callback returned, checks the plugin's grants and the admission budget, and
// only then hands it to the existing game owners, which re-check it before they
// change anything. A command that names a player addresses the stable identity;
// a command that must not survive a reconnect addresses the session it was
// issued for.
interface commands {
    use types.{player-id, position, session-id};
    use storage.{storage-mutation};
    use domain-operations.{operation-request};
    use client-presentation.{client-command};

    /// Where one message goes. A player target reaches whichever session that
    /// player has when the host applies the command, so it survives a reconnect;
    /// a session target is dropped when that exact connection is gone. A line
    /// meant for the operator log is the `host.log` import, not a command: it
    /// changes nothing in the game and needs no admission.
    variant message-target {
        player(player-id),
        session(session-id),
    }

    /// One chat line to the selected player or session.
    record send-message {
        target: message-target,
        text: string,
    }

    /// End only this connection, never a later session of the same player.
    /// The existing owner drops a request for a session that has gone away.
    /// Reasons are nonempty and at most 1024 UTF-8 bytes, as in the server DTO.
    record disconnect-player {
        session: session-id,
        reason: string,
    }

    /// One read of this plugin's own durable storage. The host binds the owner;
    /// a plugin cannot name another plugin's key.
    record storage-get {
        /// The plugin's correlation id, 1..64 bytes of lowercase letters, digits,
        /// `_` and `-`. The answer names it back, so a plugin may keep several
        /// reads in flight.
        request: string,
        /// 1..128 bytes.
        key: string,
    }

    /// One compare-and-swap of this plugin's own durable storage.
    record storage-cas {
        /// The plugin's correlation id, 1..64 bytes, as in `storage-get`.
        request: string,
        /// 1..128 bytes.
        key: string,
        /// The revision the swap expects. Absent means "only if the key holds
        /// nothing"; a plugin never picks the revision it creates.
        expected-version: option<u64>,
        /// 1..4096 bytes.
        value: string,
    }

    /// One bounded read of the players who are connected right now.
    record list-online-players {
        /// The plugin's correlation id, 1..64 bytes, as in `storage-get`.
        request: string,
        /// How many players the plugin wants at most, 1..256. The server answers
        /// fewer and sets `truncated` when more were connected.
        limit: u32,
    }

    /// One authoritative teleport of one connected player, inside the dimension
    /// that player is already in.
    ///
    /// The request names the *session*, not the stable identity, because a
    /// teleport is an effect on one live connection: a request the server
    /// receives after that connection ended is refused with
    /// `player-unavailable` instead of moving whoever holds the identity now.
    /// There is no dimension member - cross-dimension transfer is not part of
    /// this contract.
    ///
    /// A package may send it only when its manifest declares the
    /// `player_teleport` capability; the host converts a batch under the
    /// package's own grants, so an undeclared capability is refused before the
    /// server sees the command.
    ///
    /// Bounds: this record carries no list and no text, so the host-call budget
    /// is not what bounds it. Its correlation id is the contract's 64-byte
    /// script id and its coordinates are the `position` bounds, both enforced
    /// when the host converts the record into the server's own DTO - a request
    /// outside them is refused, never clamped.
    record teleport-player {
        /// The plugin's correlation id, 1..64 bytes, as in `storage-get`. The
        /// answer event carries it back, so a plugin may keep several teleports
        /// in flight.
        request: string,
        /// The connection to move.
        session: session-id,
        /// Where the player goes. The server's own position validator bounds
        /// every coordinate as `position` documents; the host refuses a request
        /// outside those bounds rather than clamping it.
        position: position,
    }

    /// One atomic batch of mutations of this plugin's own durable storage.
    ///
    /// A batch is all-or-nothing: it changes every key it names at one revision,
    /// or it changes nothing. Canonicalization, replication and durability belong
    /// to the server's storage owner; a plugin only asks.
    ///
    /// A plugin names the operation twice and both names survive the contract. The
    /// `request` correlates the answer with this call. The `operation-id` is the
    /// durable name the server records the commit under, which is what a later
    /// `operation-status` addresses: a plugin that never saw its answer, or that
    /// restarted, or that wants the outcome of a commit it made long ago, re-probes
    /// by that id instead of re-applying the batch.
    ///
    /// A package may send it only when its manifest declares the
    /// `storage_batches` capability, which the operator grants this deployment.
    /// `required_features` is not a type of this contract but a manifest-internal
    /// consistency rule. The component manifest's `FEATURE_CAPABILITIES`
    /// vocabulary is validated so a manifest that declares a feature-capability
    /// without the matching `required_features` entry is refused as malformed
    /// before any guest runs. It grants nothing and is no substitute for a
    /// capability: what admits a command is the capability the manifest declared
    /// and the operator's grant of it.
    /// The host converts a callback's commands under the package's own grants,
    /// so an undeclared capability is refused by name before the server sees
    /// anything.
    ///
    /// Bounds: this record's list is the one the server's own operation DTO
    /// already validates, and its bounds are that DTO's - at most
    /// `mc_script::MAX_INVENTORY_STORAGE_MUTATIONS` (16) mutations, each key
    /// 1..`MAX_PLUGIN_STORAGE_KEY_BYTES` (128) bytes and unique inside the batch,
    /// each value 1..`MAX_PLUGIN_STORAGE_VALUE_BYTES` (4096) bytes, each expected
    /// revision at most `MAX_SCRIPT_WORLD_TIME`, and at least one mutation. They are
    /// enforced by `mc_script`'s storage-mutation validator when the host converts
    /// this record into the DTO: a batch outside them is refused as the plugin's
    /// own malformed answer, never clamped, and never truncated afterwards. The
    /// whole answer is additionally bounded before Wasmtime copies anything out of
    /// guest memory by `PluginLimits::hostcall_bytes`.
    record storage-batch-cas {
        /// The plugin's correlation id, 1..64 bytes, as in `storage-get`. The
        /// answer carries it back, so a plugin may keep several batches in flight.
        request: string,
        /// The durable operation id, 1..64 bytes in the same alphabet. A batch
        /// that repeats an operation id with byte-identical content replays the
        /// outcome the server recorded and applies nothing; one that reuses an id
        /// for different content is refused with `operation-conflict`.
        operation-id: string,
        /// The mutations to apply, as one atomic batch.
        mutations: list<storage-mutation>,
    }

    /// One probe of a durable operation this plugin already named.
    ///
    /// It reads the outcome the server recorded for that operation id and applies
    /// nothing, which is why it is the safe thing a plugin does when it does not
    /// know whether an earlier batch committed. An id the server never recorded is
    /// answered `not-found`: a lookup that found nothing, not evidence that the
    /// operation was refused.
    ///
    /// A package may send it only when its manifest declares the
    /// `storage_batches` capability, exactly as for `storage-batch-cas`.
    ///
    /// Bounds: the record carries no list and no text beyond its two ids, each the
    /// contract's 64-byte script id, so it is the host-call budget
    /// (`PluginLimits::hostcall_bytes`) that bounds what lifting it costs.
    record operation-status {
        /// The plugin's correlation id, 1..64 bytes.
        request: string,
        /// The durable operation id to look up, 1..64 bytes.
        operation-id: string,
    }

    /// One unprotected zone: a bounded box of finite coordinates and nothing else.
    ///
    /// The owner derives membership, lifecycle and protection from the box it was
    /// given, so no other shape of region exists in this contract and a plugin
    /// cannot declare one it does not own: the owner keys every zone by the plugin
    /// that defined it. The owner admits every edit inside this box, which is what
    /// a zone with no protection record means - not "protection to be decided
    /// later"; a plugin that wants the owner to protect the box sends
    /// `upsert-protected-zone` instead.
    ///
    /// A package may send it only when its manifest declares the `zones`
    /// capability; the host converts a callback's commands under the package's own
    /// grants, so an undeclared capability is refused by name before the server
    /// sees the command.
    ///
    /// The answer is `zone-command-answered`, naming the zone this command named:
    /// a zone command carries no correlation id, because the server's own zone
    /// answer names the zone rather than a request.
    ///
    /// Bounds: this record carries no list and no text of the plugin's own, so the
    /// host-call budget (`PluginLimits::hostcall_bytes`) is not what bounds it. Its
    /// `zone` is the contract's script id and its `dimension` a contract resource
    /// id, and both are enforced - with the two corners - by `mc_script`'s own zone
    /// validator (`ScriptAxisAlignedZone::try_new`) when the host converts this
    /// record into the server's DTO: an id, a dimension or a coordinate the
    /// validator cannot accept is refused as the plugin's own malformed answer,
    /// never clamped, truncated or defaulted. A box whose minimum corner is past
    /// its maximum is refused the same way, because the server has no zone to make
    /// of it.
    record upsert-zone {
        /// The zone's id, 1..`mc_script::MAX_SCRIPT_ID_BYTES` (64) bytes of
        /// lowercase letters, digits, `_` and `-`, in the same alphabet as
        /// `storage-get`'s request id. The owner's answer names it back.
        zone: string,
        /// The dimension the box lives in, 1..`mc_script::MAX_SCRIPT_RESOURCE_ID_BYTES`
        /// (128) bytes as a contract resource id, for example `minecraft:overworld`.
        dimension: string,
        /// The box's lower corner, with every coordinate inside the `position`
        /// bounds.
        minimum: position,
        /// The box's upper corner. Every coordinate is at or past the matching one
        /// of `minimum`.
        maximum: position,
    }

    /// One protected zone: the same box as `upsert-zone`, plus the one protection
    /// record that belongs to it.
    ///
    /// The protection record names the one actor whose edits inside the box the
    /// owner admits, whoever runs it; an operator of the server is admitted either
    /// way. Naming nobody is not a way to build an unprotectable box - a zone the
    /// owner cannot protect is refused, and a plugin that wants no protection sends
    /// `upsert-zone` instead.
    ///
    /// `zone`, `dimension`, `minimum` and `maximum` are `upsert-zone`'s own four
    /// fields under the bounds documented there, and the same `zones` capability
    /// admits this command. The protection record is one player uuid of at most
    /// `mc_script::MAX_SCRIPT_PLAYER_UUID_BYTES` (64) bytes, enforced by
    /// `ScriptZoneProtection::try_actor_or_operator` when the host converts this
    /// record: a value the server's validator cannot accept is refused as the
    /// plugin's own malformed answer, never clamped and never replaced with a
    /// default actor. The answer is `zone-command-answered`, as for `upsert-zone`.
    record upsert-protected-zone {
        /// The zone's id, 1..`mc_script::MAX_SCRIPT_ID_BYTES` (64) bytes.
        zone: string,
        /// The dimension the box lives in, 1..`mc_script::MAX_SCRIPT_RESOURCE_ID_BYTES`
        /// (128) bytes as a contract resource id.
        dimension: string,
        /// The uuid of the one actor the owner admits inside the box, 1..64 bytes.
        /// The owner normalizes it the way it normalizes every player uuid, so a
        /// uuid the server accepts is the same actor however it is written.
        allowed-actor-uuid: string,
        /// The box's lower corner, with every coordinate inside the `position`
        /// bounds.
        minimum: position,
        /// The box's upper corner. Every coordinate is at or past the matching one
        /// of `minimum`.
        maximum: position,
    }

    /// One removal of a zone this plugin owns.
    ///
    /// A removal is idempotent in the owner: an id the owner does not hold is
    /// applied as nothing to remove, not refused. The answer says which of the two
    /// the owner did, by naming the zone and whether it took the command.
    ///
    /// A package may send it only when its manifest declares the `zones`
    /// capability, exactly as for `upsert-zone`; the owner removes only zones the
    /// plugin itself defined, so a removal never reaches another package's box.
    ///
    /// Bounds: the record carries this contract's script id and nothing else, which
    /// `mc_script`'s own command validator enforces when the host converts it: an
    /// id the validator cannot accept is refused as the plugin's own malformed
    /// answer.
    record remove-zone {
        /// The zone to remove, 1..`mc_script::MAX_SCRIPT_ID_BYTES` (64) bytes.
        zone: string,
    }

    /// One timer this plugin owns, to fire after a delay of pushed simulation
    /// ticks.
    ///
    /// The command stays inside the host that owns this instance: a timer is the
    /// plugin's own memory, not a server object, so nothing about it reaches the
    /// game owners and no other plugin can name, replace or cancel one of these
    /// ids. The host fires it from the simulation ticks the server already pushes
    /// into the boundary - a plugin needs no subscription for that and no
    /// `server.tick` member exists here - and drops the whole schedule when the
    /// instance is retired. Nothing about it survives the host.
    ///
    /// A timer fires at most once per scheduling: the host delivers one
    /// `timer-fired` event when the simulation reaches the deadline, and a plugin
    /// that wants a repeating timer schedules the next one from that callback.
    ///
    /// A schedule that names an id the plugin already holds replaces it, and the
    /// new delay is counted from the tick this callback observed - never from the
    /// deadline the replaced timer had - so a late callback reschedules relative
    /// to where the simulation is, not relative to where it should have been. A
    /// replace is admitted even while the plugin holds the contract's maximum of
    /// timers; only scheduling an id it does not hold past that maximum is
    /// refused.
    ///
    /// A package may send it with no capability: the host owns the timer state of
    /// its own instance, exactly as it owns the guest's memory.
    ///
    /// Bounds: the id is the contract's own script id, 1..64 bytes of lowercase
    /// letters, digits, `_` and `-`, in the same alphabet as `storage-get`'s
    /// request id; the delay is 1..630720000 ticks; and the deadline the observed
    /// tick and the delay add up to is checked, so a sum that does not fit a `u64`
    /// is refused rather than wrapped. The host checks every timer command of a
    /// callback's answer before it applies any of that answer, so a request
    /// outside these bounds - or one past the pending maximum - is refused as the
    /// plugin's own malformed answer and the instance is retired, exactly as it is
    /// for a command the server's DTO cannot accept.
    record schedule-timer {
        /// The plugin's own timer id, 1..64 bytes, in the same alphabet as
        /// `storage-get`'s request id. The `timer-fired` event names it back.
        timer-id: string,
        /// How many pushed ticks from the observed one the timer waits,
        /// 1..630720000.
        delay-ticks: u64,
    }

    /// One timer this plugin no longer wants.
    ///
    /// Cancelling an id the plugin holds removes it before it fires anything.
    /// Cancelling an id it does not hold - one that already fired, one it never
    /// scheduled, one an earlier callback cancelled - is applied as nothing to
    /// change, because a plugin cannot observe the schedule of a callback that
    /// ran before it and a refusal would tell it nothing about its own work.
    ///
    /// A timer an earlier callback cancels cannot fire in the same pushed tick,
    /// even after it became due: the host takes each due timer only after the
    /// callback before it returned, so the cancel is already in the schedule the
    /// next one is chosen from.
    ///
    /// A package may send it with no capability, exactly as for `schedule-timer`.
    ///
    /// Bounds: the id is the contract's own script id, 1..64 bytes, checked
    /// exactly as `schedule-timer`'s is.
    record cancel-timer {
        /// The plugin's own timer id, 1..64 bytes.
        timer-id: string,
    }

    /// Resource-count delta, not an item-stack replacement. Resource ids are
    /// 1..128 bytes; amounts are nonzero and at most 64 in magnitude.
    record inventory-resource-delta {
        /// The item resource the delta counts, for example `minecraft:emerald`.
        %resource: string,
        /// Positive grants items; negative removes them.
        delta: s16,
    }

    /// Atomic mutation of one live session's inventory and this plugin's storage.
    /// The existing session gate, save coordinator and world journal own commit,
    /// recovery and publication. Missing sessions, insufficient inventory and
    /// stale storage revisions refuse the whole transaction.
    ///
    /// Requires `inventory_storage_transactions`. Both lists contain 1..16
    /// entries, with unique resources and storage keys. Storage keys are 1..128
    /// bytes, values 1..4096 bytes, and expected revisions at most
    /// `MAX_SCRIPT_WORLD_TIME`; the existing DTO constructors validate them.
    /// `PluginLimits::text_bytes` bounds each string, while `hostcall_bytes`
    /// bounds the entire transfer before lifting.
    ///
    /// `request` is correlation only and may be reused after completion. This
    /// operation has no durable operation-id receipt. A missing answer does not
    /// establish refusal and must not trigger a blind retry.
    record inventory-storage-transaction {
        /// The plugin's correlation id, 1..64 bytes, as in `storage-get`. The
        /// answer carries it back and it is correlation only.
        request: string,
        /// The connection whose inventory the transaction changes.
        session: session-id,
        /// The item counts to add and remove, applied as one set.
        inventory: list<inventory-resource-delta>,
        /// The storage mutations applied at the same time.
        storage: list<storage-mutation>,
    }

    /// One fixed slot of a server-owned inventory menu.
    ///
    /// The record describes what the menu shows and nothing else: the index the
    /// item appears at, the item resource, how many of it, and the line the
    /// client renders in place of the item's own name. It names no item stack,
    /// no slot state and no client packet, because the server's own menu owner
    /// renders it and a plugin never handles the stack behind it.
    ///
    /// Bounds: `slot` is 0..`mc_script::MAX_INVENTORY_MENU_SLOTS` (54), the
    /// resource id 1..128 bytes, `count` at least one (and at most 255, being a
    /// `u8`), and the label, when present, 0..128 bytes. They are enforced by
    /// `mc_script`'s own `ScriptInventoryMenuItem::try_new` and
    /// `ScriptInventoryMenu::try_new` when the host converts this record into
    /// the server's DTO: an index, a resource, a count or a label the validator
    /// cannot accept is refused as the plugin's own malformed answer, never
    /// clamped and never replaced with a slot the plugin did not ask for.
    record inventory-menu-slot {
        /// Where the item appears in the menu, 0..54.
        slot: u8,
        /// The item resource the slot shows, 1..128 bytes, for example
        /// `minecraft:apple`.
        %resource: string,
        /// How many of that item the slot shows, at least one.
        count: u8,
        /// The line the client renders for the slot, at most 128 bytes;
        /// absent means the item's own name.
        label: option<string>,
    }

    /// One whole menu: the id a click names back, the title the client renders,
    /// and the fixed slots it shows.
    ///
    /// A menu is shown on *one live connection*, like a teleport: the request that
    /// carries it names the session it was built for, so a menu opened after that
    /// connection ended is refused by the server's own menu owner instead of
    /// appearing for that player's later session. The server owns the menu
    /// once it admits it: it renders the slots, routes a click on one of them back
    /// to the plugin that opened the menu, and drops the menu with the connection.
    ///
    /// Bounds: the id is the contract's own script id, 1..64 bytes of lowercase
    /// letters, digits, `_` and `-`, in the same alphabet as `storage-get`'s
    /// request id; the title is 1..128 bytes; the list holds at most 54 slots,
    /// each index distinct, and a menu with no slots is a menu with nothing to
    /// click rather than an error. Every one of them is enforced by the same
    /// `mc_script` constructors the slot record documents.
    record inventory-menu {
        /// The menu's id, 1..64 bytes. A click event names it back, and a close
        /// names it.
        id: string,
        /// The title the client renders, 1..128 bytes.
        title: string,
        /// The slots the menu shows, at most 54, with pairwise distinct indexes.
        slots: list<inventory-menu-slot>,
    }

    /// One request to show a menu to the client of one live session.
    ///
    /// The session is named rather than the stable identity, exactly as for
    /// `teleport-player`: a menu exists on one connection, so a request the
    /// server receives after that connection ended is refused instead of being
    /// shown to whoever holds the identity now.
    ///
    /// A package may send it only when its manifest declares the
    /// `inventory_menus` capability; the host converts a callback's commands
    /// under the package's own grants, so an undeclared capability is refused by
    /// name before the server sees the command.
    ///
    /// The request is fire-and-forget: opening a menu carries no correlation id
    /// and no event of this contract answers it, because the server records no
    /// receipt for showing one. A plugin hears about its own menu only when a
    /// player clicks one of its slots, so a plugin must not read the absence of
    /// an answer as "the client saw the menu" - and a menu the owner refuses
    /// produces no answer either way.
    ///
    /// Bounds: the record carries no text of its own beyond the menu's, which the
    /// constructors named on `inventory-menu` bound, so the host-call budget
    /// (`PluginLimits::hostcall_bytes`) is not what bounds it; that budget is
    /// what bounds the whole answer before Wasmtime copies anything out of guest
    /// memory.
    record open-inventory-menu {
        /// The connection whose client should see the menu.
        session: session-id,
        /// The menu to show.
        menu: inventory-menu,
    }

    /// One request to close a menu this plugin opened for one live session.
    ///
    /// The request names the session and the menu rather than the object the
    /// server holds: a plugin asks for its own menu to go away, and a close for a
    /// session that has ended is refused rather than closing the menu of a
    /// connection that holds the id now. A close for a menu that connection is not
    /// showing is nothing to close rather than a refusal: the owner sends no close
    /// for it and the connection keeps whatever it had open, and this contract
    /// carries no answer that could report which of the two happened.
    ///
    /// The same `inventory_menus` capability admits it, and it is
    /// fire-and-forget exactly as `open-inventory-menu` is: no correlation id, no
    /// answer event, and a refusal that reaches the plugin only as the connection
    /// carrying on with the menu it had.
    ///
    /// Bounds: the record carries the contract's script id and nothing else,
    /// which `mc_script`'s own command validator enforces when the host converts
    /// it: an id the validator cannot accept is refused as the plugin's own
    /// malformed answer, never truncated.
    record close-inventory-menu {
        /// The connection whose client should lose the menu.
        session: session-id,
        /// The menu id to close, 1..64 bytes.
        menu: string,
    }

    /// One request from a plugin. Every member is a request, never an effect:
    /// the host validates the whole batch a callback returned, checks the
    /// plugin's grants and the admission budget where a game owner is involved,
    /// and applies the timer members to the plugin's own schedule only once the
    /// batch that carried them was admitted. New members are added by the
    /// phases that implement the operation behind them; no member exists here
    /// before its operation does.
    variant command {
        send-message(send-message),
        storage-get(storage-get),
        storage-cas(storage-cas),
        list-online-players(list-online-players),
        teleport-player(teleport-player),
        storage-batch-cas(storage-batch-cas),
        operation-status(operation-status),
        upsert-zone(upsert-zone),
        upsert-protected-zone(upsert-protected-zone),
        remove-zone(remove-zone),
        /// A nonempty chat line, at most 4096 UTF-8 bytes, to all online players.
        broadcast(string),
        disconnect-player(disconnect-player),
        /// One timer this plugin owns, scheduled from the tick its callback
        /// observed. The host applies it to the instance's own schedule; the
        /// server never sees it and it needs no capability.
        schedule-timer(schedule-timer),
        /// One timer this plugin no longer wants, applied by the host with the
        /// same rules.
        cancel-timer(cancel-timer),
        /// One atomic transaction of one session's inventory and this plugin's own
        /// durable storage, applied by the existing owners together or not at all.
        /// Its answer is `inventory-storage-transaction-answered`.
        inventory-storage-transaction(inventory-storage-transaction),
        /// One menu this plugin asks the client of one live session to show. The
        /// server's menu owner renders it, owns it for that connection, and routes
        /// a click on one of its slots back as `inventory-menu-clicked`. It is
        /// fire-and-forget: no event of this contract answers it.
        open-inventory-menu(open-inventory-menu),
        /// One menu of one live session this plugin asks to close, applied by the
        /// same owner and answered by no event either.
        close-inventory-menu(close-inventory-menu),
        operation(operation-request),
        /// One typed Loader-bound client-presentation request: a view this plugin
        /// owns, a sound it owns, or a grant of its own custom block item, applied
        /// by the server's existing Loader owners. It carries no command
        /// capability, and that is the Loader's own design rather than an
        /// omission: the pair that admits these requests is the Loader manifest's
        /// bundled content and its permission, checked inside the owner that
        /// applies the request, so an undeclared view, sound or block is refused
        /// there instead of here and this contract does not restate the pair as a
        /// capability. Each request names one live session, never a stable
        /// identity, so a request arriving after that connection ended is refused
        /// rather than retargeted to a later session.
        client-presentation(client-command),
    }
}
