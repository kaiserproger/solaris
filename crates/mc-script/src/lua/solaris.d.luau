-- Check-only host declarations; never executed in a plugin VM.
-- Domain-specific records still undergo the runtime's closed-shape validation.
export type SolarisTable = { [any]: any }
export type SolarisPosition = { x: number, y: number, z: number }
export type SolarisInventoryDelta = { resource: string, delta: number }
export type SolarisMenuSlot = { slot: number, resource: string, count: number, label: string? }
export type SolarisStorageMutation = {
    operation: string,
    key: string,
    expected_version: number?,
    value: string?,
}
export type SolarisPlayerCommandEvent = {
    name: string,
    player_id: number,
    username: string,
    uuid: string,
    context_verified: boolean,
    operator: boolean,
    x: number,
    y: number,
    z: number,
    root: string,
    arguments: string,
}

declare solaris: {
    config: () -> SolarisTable,
    schedule_timer: (timer_id: string, delay_ticks: number) -> number,
    cancel_timer: (timer_id: string) -> boolean,
    send_message: (player_id: number, message: string) -> (),
    broadcast: (message: string) -> (),
    disconnect: (player_id: number, reason: string) -> (),
    send_custom_payload: (player_id: number, channel: string, payload: string) -> (),
    spawn_entity: (request_id: string, player_id: number, entity_type: string, x: number, y: number, z: number) -> (),
    damage_entity: (request_id: string, entity_id: number, amount: number) -> (),
    storage_get: (request_id: string, key: string) -> (),
    storage_cas: (request_id: string, key: string, expected_version: number?, value: string) -> (),
    storage_delete: (request_id: string, key: string, expected_version: number?) -> (),
    storage_batch_cas: (request_id: string, operation_id: string, mutations: {SolarisStorageMutation}) -> (),
    storage_scan: (request_id: string, prefix: string, cursor: string?, limit: number) -> (),
    operation_status: (request_id: string, operation_id: string) -> (),
    open_inventory_menu: (player_id: number, menu_id: string, title: string, slots: {SolarisMenuSlot}) -> (),
    close_inventory_menu: (player_id: number, menu_id: string) -> (),
    inventory_transaction: (player_id: number, request_id: string, inventory: {SolarisInventoryDelta}) -> (),
    inventory_storage_transaction: (player_id: number, request_id: string, inventory: {SolarisInventoryDelta}, storage: {SolarisStorageMutation}) -> (),
    list_online_players: (request_id: string, limit: number?) -> (),
    teleport_player: (request_id: string, player_id: number, x: number, y: number, z: number) -> (),
    set_world_time: (request_id: string, world_time: number) -> (),
    set_block: (request_id: string, dimension: string, block_id: string, x: number, y: number, z: number) -> (),
    upsert_zone: (zone_id: string, dimension: string, min_x: number, min_y: number, min_z: number, max_x: number, max_y: number, max_z: number) -> (),
    upsert_protected_zone: (zone_id: string, dimension: string, allowed_actor_uuid: string, min_x: number, min_y: number, min_z: number, max_x: number, max_y: number, max_z: number) -> (),
    remove_zone: (zone_id: string) -> (),
    query_owned_inventory: (request_id: string, endpoint: SolarisTable, expected_revision: number?) -> (),
    transfer_owned_items: (request_id: string, operation_id: string, actor_id: number, transfers: {SolarisTable}, expected_revisions: {SolarisTable}) -> (),
    reserve_inventory_items: (request_id: string, operation_id: string, endpoint: SolarisTable, resource_plan: SolarisTable, expected_revision: SolarisTable) -> (),
    inventory_reservation_status: (request_id: string, reservation_ref: string) -> (),
    release_inventory_reservation: (request_id: string, operation_id: string, reservation_ref: string, expected_revision: number) -> (),
    claim_resident: (request_id: string, operation_id: string, actor_id: number, entity_uuid: string, expected_entity_revision: number) -> (),
    spawn_resident: (request_id: string, operation_id: string, spawn_site_token: string, profile: SolarisTable) -> (),
    query_residents: (request_id: string, handles: {string}, cursor: string?) -> (),
    release_resident: (request_id: string, operation_id: string, handle: string, expected_revision: number) -> (),
    set_resident_pois: (request_id: string, operation_id: string, handle: string, home_poi: string?, work_poi: string?, meeting_poi: string?, expected_revision: number) -> (),
    assign_resident_work: (request_id: string, operation_id: string, handle: string, work_order: SolarisTable, work_units: number, expected_revision: number) -> (),
    cancel_resident_work: (request_id: string, operation_id: string, handle: string, expected_revision: number) -> (),
    issue_resident_order: (request_id: string, operation_id: string, handles: {string}, expected_order_revisions: {number}, order: SolarisTable) -> (),
    cancel_resident_order: (request_id: string, operation_id: string, handles: {string}, expected_order_revisions: {number}) -> (),
    demobilize_resident: (request_id: string, operation_id: string, handle: string, expected_revision: number) -> (),
    list_settlement_sites: (request_id: string, cursor: string?, limit: number) -> (),
    query_settlement_site: (request_id: string, site_id: string, cursor: string?, limit: number) -> (),
    reserve_resident_site: (request_id: string, operation_id: string, site_id: string, poi_id: string, expected_site_revision: number) -> (),
    release_resident_site: (request_id: string, operation_id: string, spawn_site_token: string) -> (),
    survey_site: (request_id: string, dimension: string, bounds: SolarisTable, purpose: string) -> (),
    prepare_structure: (request_id: string, operation_id: string, blueprint_id: string, anchor: SolarisPosition, rotation: number, survey_token: string, expected_site_revision: number) -> (),
    advance_structure: (request_id: string, operation_id: string, structure_id: string, stage: string, reservation_ref: string, expected_revision: number, work_units: number) -> (),
    pause_structure: (request_id: string, operation_id: string, structure_id: string, expected_revision: number) -> (),
    cancel_structure: (request_id: string, operation_id: string, structure_id: string, expected_revision: number) -> (),
    structure_status: (request_id: string, structure_id: string) -> (),
    bind_warehouse: (request_id: string, operation_id: string, structure_id: string, container_id: number) -> (),
    open_client_view: (request_id: string, player_id: number, owned_view_id: string, model: SolarisTable) -> (),
    present_client_view: (player_id: number, view_instance_id: string, expected_revision: number, model: SolarisTable) -> (),
    close_client_view: (player_id: number, view_instance_id: string) -> (),
    begin_client_selection: (request_id: string, player_id: number, view_instance_id: string, view_revision: number, action_id: string, constraints: SolarisTable) -> (),
    cancel_client_selection: (player_id: number, selection_context_id: string) -> (),
    play_client_sound: (player_id: number, sound_id: string, options: {volume: number?, pitch: number?, position: SolarisPosition?}) -> (),
    stop_client_sound: (player_id: number, sound_id: string) -> (),
    place_loader_block: (request_id: string, block_id: string, x: number, y: number, z: number) -> (),
    grant_loader_block_item: (request_id: string, player_id: number, block_id: string, count: number) -> (),
}
