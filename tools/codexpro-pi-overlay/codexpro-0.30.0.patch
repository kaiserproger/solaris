+export async function waitPiAgent(workspace, options = {}) {
+  const runId = String(options.run_id ?? "").trim();
+  if (!runId) throw new CodexProError("run_id is required.");
+  const runDir = path.join(workspace.root, ".ai-bridge", "pi-agents", runId);
+  const metadataPath = path.join(runDir, "metadata.json");
+  let metadata;
+  try {
+    metadata = JSON.parse(await fsp.readFile(metadataPath, "utf8"));
+  } catch {
+    throw new CodexProError(`Pi run metadata not found: ${path.relative(workspace.root, metadataPath)}`);
+  }
+
+  const donePath = path.join(runDir, "done");
+  let done = await fsp.access(donePath).then(() => true).catch(() => false);
+  if (!done && Number(options.max_wait_seconds ?? 0) > 0) {
+    done = await waitForDoneEvent(donePath, options.max_wait_seconds);
+  }
+  let running = false;
+  if (!done && metadata.tmux_session) {
+    running = run("tmux", ["has-session", "-t", metadata.tmux_session], {
+      cwd: workspace.root,
+      allowFailure: true
+    }).status === 0;
+  }
+  const agentExit = await readTrimmed(path.join(runDir, "agent.exit"));
+  const exportExit = await readTrimmed(path.join(runDir, "export.exit"));
+  const logTail = await tailFile(path.join(runDir, "agent.log"), Number(options.log_tail_bytes ?? 16000));
