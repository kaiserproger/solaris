+
+import fsp from "node:fs/promises";
+import { watch as watchFs } from "node:fs";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { CodexProError } from "./guard.js";
+
+const MAX_CAPTURE_BYTES = 64 * 1024 * 1024;
+const MAX_UNTRACKED_SEED_BYTES = 64 * 1024 * 1024;
+
+function run(command, args, options = {}) {
+  const result = spawnSync(command, args, {
+    cwd: options.cwd,
+    input: options.input,
+    encoding: "utf8",
+    maxBuffer: options.maxBuffer ?? MAX_CAPTURE_BYTES,
+    env: options.env ?? process.env
+  });
+  if (result.error) {
+    throw new CodexProError(`${command} failed to start: ${result.error.message}`);
+  }
+  if (result.status !== 0 && !options.allowFailure) {
+    const stderr = String(result.stderr ?? "").trim();
+    const stdout = String(result.stdout ?? "").trim();
+    throw new CodexProError(
+      `${command} ${args.join(" ")} failed with exit ${result.status}: ${stderr || stdout || "no output"}`
+    );
+  }
+  return {
+    status: result.status ?? 1,
+    stdout: String(result.stdout ?? ""),
+    stderr: String(result.stderr ?? "")
+  };
+}
+
+function shellQuote(value) {
+  return `'${String(value).replace(/'/g, `'\"'\"'`)}'`;
+}
+
+function safeSlug(value, fallback = "agent") {
+  const slug = String(value ?? "")
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9_-]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48);
+  return slug || fallback;
+}
+
+function runIdFor(prompt) {
+  const stamp = new Date().toISOString().replace(/[-:.TZ]/g, "").slice(0, 14);
+  const digest = createHash("sha256").update(String(prompt)).update(String(Date.now())).digest("hex").slice(0, 8);
+  return `${stamp}-${digest}`;
+}
+
+async function copyUntracked(root, workDir) {
+  const listed = run("git", ["ls-files", "--others", "--exclude-standard", "-z"], { cwd: root }).stdout;
+  const files = listed.split("\0").filter(Boolean).filter((rel) => !rel.startsWith(".ai-bridge/pi-agents/"));
+  let totalBytes = 0;
+  for (const rel of files) {
+    if (path.isAbsolute(rel) || rel.split(/[\\/]+/).includes("..")) {
+      throw new CodexProError(`unsafe untracked path while seeding Pi box: ${rel}`);
+    }
+    const source = path.join(root, rel);
+    const destination = path.join(workDir, rel);
+    const stat = await fsp.lstat(source);
+    await fsp.mkdir(path.dirname(destination), { recursive: true });
+    if (stat.isSymbolicLink()) {
+      let realTarget;
+      try {
+        realTarget = await fsp.realpath(source);
+      } catch (error) {
+        throw new CodexProError(`untracked Pi seed contains a dangling symlink: ${rel}: ${error.message}`);
+      }
+      const rootAbs = path.resolve(root);
+      const targetRel = path.relative(rootAbs, realTarget);
+      if (targetRel === ".." || targetRel.startsWith(`..${path.sep}`) || path.isAbsolute(targetRel)) {
+        throw new CodexProError(`untracked Pi seed symlink escapes workspace: ${rel}`);
+      }
+      const boxedTarget = path.join(workDir, targetRel);
+      let safeTarget = path.relative(path.dirname(destination), boxedTarget);
+      if (!safeTarget) safeTarget = ".";
+      await fsp.rm(destination, { force: true, recursive: true }).catch(() => {});
+      await fsp.symlink(safeTarget, destination);
+    } else if (stat.isFile()) {
+      totalBytes += stat.size;
+      if (totalBytes > MAX_UNTRACKED_SEED_BYTES) {
+        throw new CodexProError(`untracked Pi seed exceeds ${MAX_UNTRACKED_SEED_BYTES} bytes; ignore/track large artifacts or call with seed_dirty=false`);
+      }
+      await fsp.copyFile(source, destination);
+    }
+  }
+  return files;
+}
+
+async function writePriorPiEvidenceManifest(root, workDir, currentRunId) {
+  const parent = path.join(root, ".ai-bridge", "pi-agents");
+  let entries = [];
+  try {
+    entries = (await fsp.readdir(parent, { withFileTypes: true }))
+      .filter((entry) => entry.isDirectory() && entry.name !== currentRunId)
+      .map((entry) => entry.name)
+      .sort()
+      .slice(-12);
+  } catch {
+    return null;
+  }
+  if (!entries.length) return null;
+  const lines = [
+    "# Parent Pi evidence manifest",
+    "",
+    "This is a bounded host-generated index of recent Pi runs. It contains no prompts or raw logs.",
+    "Use the project h5i forum for coordination; ask the parent for raw evidence only when a task needs it.",
+    ""
+  ];
+  for (const runId of entries) {
+    const dir = path.join(parent, runId);
+    let metadata = {};
+    try { metadata = JSON.parse(await fsp.readFile(path.join(dir, "metadata.json"), "utf8")); } catch {}
+    const done = await fsp.access(path.join(dir, "done")).then(() => true).catch(() => false);
+    const exit = await fsp.readFile(path.join(dir, "agent.exit"), "utf8").then((v) => v.trim()).catch(() => "");
+    const patchBytes = await fsp.stat(path.join(dir, "agent.patch")).then((st) => st.size).catch(() => 0);
+    let verdict = "";
+    try {
+      const log = await tailFile(path.join(dir, "agent.log"), 64 * 1024);
+      verdict = log.split(/\r?\n/).reverse().find((line) => /^(QA_RESULT|RESULT)=/.test(line.trim()))?.trim() ?? "";
+    } catch {}
+    lines.push(`- ${runId}: role=${metadata.role ?? "unknown"}; model=${metadata.model ?? "unknown"}; state=${done ? "completed" : "nonterminal"}; exit=${exit || "unknown"}; patch_bytes=${patchBytes}${verdict ? `; ${verdict}` : ""}`);
+  }
+  const destination = path.join(workDir, ".ai-bridge", "parent-pi-evidence.md");
+  await fsp.mkdir(path.dirname(destination), { recursive: true });
+  await fsp.writeFile(destination, `${lines.join("\n")}\n`, "utf8");
+  return path.relative(workDir, destination);
+}
+
+function cleanupFailedSpawn(workspaceRoot, boxName, forum) {
+  if (forum?.available && forum.identity) {
+    run("h5i", ["forum", "revoke", forum.identity], { cwd: workspaceRoot, allowFailure: true });
+  }
+  run("h5i", ["box", "abort", boxName], { cwd: workspaceRoot, allowFailure: true });
+}
+
+async function copyBoundedRuntimeTree(sourceRoot, destinationRoot, maxBytes) {
+  let totalBytes = 0;
+  let fileCount = 0;
+  const digest = createHash("sha256");
+  async function visit(sourceDir, destinationDir, relDir = "") {
+    const entries = await fsp.readdir(sourceDir, { withFileTypes: true });
+    entries.sort((a, b) => a.name.localeCompare(b.name));
+    await fsp.mkdir(destinationDir, { recursive: true });
+    for (const entry of entries) {
+      const source = path.join(sourceDir, entry.name);
+      const destination = path.join(destinationDir, entry.name);
+      const rel = relDir ? path.join(relDir, entry.name) : entry.name;
+      if (entry.isDirectory()) {
+        await visit(source, destination, rel);
+        continue;
+      }
+      if (entry.isSymbolicLink()) {
+        throw new CodexProError(`QA runtime input contains a symlink and is refused: ${rel}`);
+      }
+      if (!entry.isFile()) continue;
+      const stat = await fsp.stat(source);
+      totalBytes += stat.size;
+      if (totalBytes > maxBytes) {
+        throw new CodexProError(`QA runtime input exceeds ${maxBytes} bytes while copying ${rel}`);
+      }
+      const bytes = await fsp.readFile(source);
+      digest.update(rel.split(path.sep).join("/"));
+      digest.update("\0");
+      digest.update(bytes);
+      await fsp.mkdir(path.dirname(destination), { recursive: true });
+      await fsp.writeFile(destination, bytes);
+      fileCount += 1;
+    }
+  }
+  await fsp.rm(destinationRoot, { recursive: true, force: true });
+  await visit(sourceRoot, destinationRoot);
+  return { file_count: fileCount, bytes: totalBytes, sha256: digest.digest("hex") };
+}
+
+async function seedQaRuntimeInputs(root, workDir, role) {
+  if (role !== "qa" && role !== "reviewer") return null;
+  const source = path.join(root, "data", "vanilla");
+  const versionPath = path.join(source, "version.json");
+  const exists = await fsp.access(versionPath).then(() => true).catch(() => false);
+  if (!exists) {
+    return { copied: false, reason: "parent data/vanilla/version.json is absent" };
+  }
+  const destination = path.join(workDir, "data", "vanilla");
+  const copied = await copyBoundedRuntimeTree(source, destination, 64 * 1024 * 1024);
+  return {
+    copied: true,
+    source: "data/vanilla",
+    destination: "data/vanilla",
+    ...copied
+  };
+}
+
+async function seedCurrentWorktree(root, workDir, enabled) {
+  const head = run("git", ["rev-parse", "HEAD"], { cwd: workDir }).stdout.trim();
+  if (!enabled) {
+    return { seedCommit: head, seededTrackedDiff: false, seededUntracked: [] };
+  }
+
+  const diff = run("git", ["diff", "--binary", "HEAD"], { cwd: root }).stdout;
+  if (diff.trim()) {
+    run("git", ["apply", "--binary", "--whitespace=nowarn", "-"], {
+      cwd: workDir,
+      input: diff
+    });
+  }
+  const untracked = await copyUntracked(root, workDir);
+  const status = run("git", ["status", "--porcelain=v1"], { cwd: workDir }).stdout;
+  if (!status.trim()) {
+    return { seedCommit: head, seededTrackedDiff: Boolean(diff.trim()), seededUntracked: untracked };
+  }
+
+  run("git", ["add", "-A"], { cwd: workDir });
+  run(
+    "git",
+    [
+      "-c", "user.name=CodexPro",
+      "-c", "user.email=codexpro@local.invalid",
+      "-c", "commit.gpgsign=false",
+      "commit", "--no-gpg-sign", "-m", "codexpro: seed current worktree"
+    ],
+    { cwd: workDir }
+  );
+  const seedCommit = run("git", ["rev-parse", "HEAD"], { cwd: workDir }).stdout.trim();
+  return {
+    seedCommit,
+    seededTrackedDiff: Boolean(diff.trim()),
+    seededUntracked: untracked
+  };
+}
+
+function attachForum(workspaceRoot, boxName, role, runId) {
+  const project = path.basename(workspaceRoot).trim() || "workspace";
+  const title = `${project[0].toUpperCase()}${project.slice(1)} agent coordination`;
+  const findOpenThread = (output) => output
+    .split(/\r?\n/)
+    .find((line) => line.includes(title) && /\sopen\s/.test(line));
+  let listed = run("h5i", ["forum", "list"], { cwd: workspaceRoot, allowFailure: true });
+  let openThread = findOpenThread(listed.stdout);
+  if (!openThread) {
+    run("h5i", ["forum", "create", title, "--body", "Shared host-owned coordination thread for CodexPro-spawned Pi agents. Post claims, findings, blockers, reviews and submissions here. Agents must not close or mark this shared thread done."], {
+      cwd: workspaceRoot,
+      allowFailure: true
+    });
+    listed = run("h5i", ["forum", "list"], { cwd: workspaceRoot, allowFailure: true });
+    openThread = findOpenThread(listed.stdout);
+  }
+  const threadId = openThread?.trim().split(/\s+/)[0] ?? null;
+  const identity = `pi-${safeSlug(role, "agent")}-${runId.slice(-8)}`.slice(0, 63);
+  const forumRole = role === "qa" || role === "reviewer" ? "reviewer" : "worker";
+  const baseArgs = ["forum", "attach", boxName, "--as", identity, "--role", forumRole];
+  let attached = run("h5i", baseArgs, { cwd: workspaceRoot, allowFailure: true });
+  let trust = "confined";
+  if (attached.status !== 0) {
+    attached = run("h5i", [...baseArgs, "--allow-unconfined"], { cwd: workspaceRoot, allowFailure: true });
+    trust = "host-user-allow-unconfined";
+  }
+  const available = attached.status === 0;
+  return {
+    available,
+    identity: available ? identity : null,
+    role: available ? forumRole : null,
+    trust: available ? trust : null,
+    thread_id: available ? threadId : null,
+    thread_title: available ? title : null,
+    reason: available
+      ? trust === "confined"
+        ? "attached with enforced h5i forum confinement"
+        : "attached with explicit human --allow-unconfined override because this host only has runnable workspace isolation"
+      : String(attached.stderr || attached.stdout || "h5i forum attach failed").trim().slice(0, 1000)
+  };
+}
+
+function commonPrompt(role, userPrompt) {
+  return [
+    `You are a detached Pi ${role} subagent launched by CodexPro.`,
+    "",
+    "Execution contract:",
+    "- You are running inside an h5i box/worktree. Stay inside this workspace.",
+    "- Read AGENTS.md and relevant repo instructions before work.",
+    "- h5i is part of the execution contract. CodexPro loads the h5i skill explicitly for this Pi run; follow it for box/forum/evidence operations instead of bypassing the environment.",
+    "- Do not push, tag, reset, clean, stash, or rewrite unrelated work.",
