+async function waitForDoneEvent(donePath, maxWaitSeconds) {
+  const seconds = Math.max(0, Math.min(60, Number(maxWaitSeconds ?? 0)));
+  if (seconds <= 0) return false;
+  if (await fsp.access(donePath).then(() => true).catch(() => false)) return true;
+  return await new Promise((resolve) => {
+    const directory = path.dirname(donePath);
+    const target = path.basename(donePath);
+    let settled = false;
+    let watcher;
+    let timer;
+    const finish = (value) => {
+      if (settled) return;
+      settled = true;
+      if (timer) clearTimeout(timer);
+      if (watcher) watcher.close();
+      resolve(value);
+    };
+    try {
+      watcher = watchFs(directory, (_event, filename) => {
+        if (filename && String(filename) !== target) return;
+        fsp.access(donePath).then(() => finish(true)).catch(() => {});
+      });
+      watcher.on("error", () => finish(false));
+    } catch {
+      finish(false);
+      return;
+    }
+    // Close the race between the initial access check and watcher registration.
+    fsp.access(donePath).then(() => finish(true)).catch(() => {});
+    timer = setTimeout(() => finish(false), seconds * 1000);
+  });
+}
