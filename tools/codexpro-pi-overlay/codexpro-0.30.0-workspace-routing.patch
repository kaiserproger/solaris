+function resolvePiWorkspace(workspaces, args) {
+    const repoRoot = typeof args.repo_root === "string" ? args.repo_root.trim() : "";
+    const repoSubdir = typeof args.repo_subdir === "string" ? args.repo_subdir.trim() : "";
+    if (repoRoot && args.workspace_id) {
+        throw new CodexProError("Pi tools accept workspace_id or repo_root, not both.");
+    }
+    if (repoSubdir && !repoRoot) {
+        throw new CodexProError("repo_subdir requires repo_root.");
+    }
+    if (!repoRoot) {
+        return workspaces.getWorkspace(args.workspace_id);
+    }
+    if (path.isAbsolute(repoSubdir) || repoSubdir.split(/[\\/]+/).includes("..")) {
+        throw new CodexProError("repo_subdir must be a relative path that stays inside repo_root.");
+    }
+    const requestedRoot = repoSubdir ? path.join(repoRoot, repoSubdir) : repoRoot;
+    return workspaces.openWorkspace(requestedRoot, { select: false });
+}
