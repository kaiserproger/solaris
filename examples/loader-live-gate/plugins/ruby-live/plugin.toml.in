id = "ruby-live"
name = "Ruby Loader Live Gate"
version = "1.0.0"
api = "0.6.0"
player_commands = ["loader_ruby"]

[client]
schema = 1

[[client.bundles]]
id = "rich-content"
version = "1"
artifact = "client/rich-content.zip"
sha256 = "@ARTIFACT_SHA256@"
size_bytes = @ARTIFACT_SIZE@
loaders = ["fabric", "neoforge", "forge"]
content = ["blocks", "items", "ui", "assets", "interactions", "sounds"]
permissions = [
  "register_blocks",
  "register_items",
  "present_ui",
  "load_assets",
  "send_interactions",
  "play_sounds",
]
