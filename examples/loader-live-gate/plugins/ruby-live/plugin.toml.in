id = "ruby-live"
name = "Ruby Loader Live Gate"
version = "1.0.0"
api = "0.7.0"
events = ["player.joined", "player.left"]
player_commands = ["loader_ruby"]

[client]
schema = 2

[[client.bundles]]
id = "rich-content"
version = "1"
artifact = "client/rich-content.zip"
sha256 = "@ARTIFACT_SHA256@"
size_bytes = @ARTIFACT_SIZE@
loaders = ["fabric", "neoforge", "forge"]
content = ["blocks", "items", "views", "view_actions", "assets", "sounds"]
permissions = [
  "register_blocks",
  "register_items",
  "present_views",
  "send_view_actions",
  "load_assets",
  "play_sounds",
]
