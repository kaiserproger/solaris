{
  "schema": 2,
  "screens": [{
    "id": "ruby-live:showcase",
    "kind": "settlement",
    "title": "Ruby Loader Fixture",
    "item_id": "ruby-live:ruby",
    "block_id": "ruby-live:ruby_block",
    "widgets": [{
      "type": "paged_table",
      "id": "roster",
      "columns": [{"id": "name", "label": "Name", "align": "left", "width_bucket": 2}]
    }, {
      "type": "resource_panel",
      "id": "cost",
      "label": "Cost",
      "entries": [{"id": "ruby", "label": "Ruby"}]
    }, {
      "type": "action_button",
      "action_id": "confirm",
      "label": "Confirm Ruby"
    }]
  }, {
    "id": "ruby-live:hud",
    "kind": "hud",
    "title": "Ruby HUD",
    "widgets": [{
      "type": "paged_table",
      "id": "status",
      "columns": [
        {"id": "label", "label": "Panel", "align": "left", "width_bucket": 2},
        {"id": "state", "label": "State", "align": "left", "width_bucket": 2}
      ]
    }]
  }, {
    "id": "ruby-live:input",
    "kind": "hud",
    "title": "Ruby input",
    "widgets": []
  }],
  "blocks": [{
    "id": "ruby-live:ruby_block",
    "model": "ruby-live:block/ruby_block",
    "name": "Ruby Fixture Block"
  }],
  "items": [{
    "id": "ruby-live:ruby",
    "base_item": "minecraft:paper",
    "name": "Ruby Fixture Item"
  }],
  "assets": [{
    "id": "ruby-live:ruby_item_definition",
    "path": "assets/ruby-live/items/ruby.json",
    "sha256": "@ITEM_SHA256@",
    "size_bytes": @ITEM_SIZE@
  }, {
    "id": "ruby-live:ruby_block_model",
    "path": "assets/ruby-live/models/block/ruby_block.json",
    "sha256": "@BLOCK_SHA256@",
    "size_bytes": @BLOCK_SIZE@
  }]
}
