{
  "schema": 2,
  "screens": [{
    "id": "sapphire-live:showcase",
    "kind": "settlement",
    "title": "Sapphire Loader Fixture",
    "item_id": "sapphire-live:sapphire",
    "block_id": "sapphire-live:sapphire_block",
    "widgets": [{
      "type": "paged_table",
      "id": "roster",
      "columns": [{"id": "name", "label": "Name", "align": "left", "width_bucket": 2}]
    }, {
      "type": "resource_panel",
      "id": "cost",
      "label": "Cost",
      "entries": [{"id": "sapphire", "label": "Sapphire"}]
    }, {
      "type": "action_button",
      "action_id": "confirm",
      "label": "Confirm Sapphire"
    }]
  }],
  "blocks": [{
    "id": "sapphire-live:sapphire_block",
    "model": "sapphire-live:block/sapphire_block",
    "name": "Sapphire Fixture Block"
  }],
  "items": [{
    "id": "sapphire-live:sapphire",
    "base_item": "minecraft:paper",
    "name": "Sapphire Fixture Item"
  }],
  "assets": [{
    "id": "sapphire-live:sapphire_item_definition",
    "path": "assets/sapphire-live/items/sapphire.json",
    "sha256": "@ITEM_SHA256@",
    "size_bytes": @ITEM_SIZE@
  }, {
    "id": "sapphire-live:sapphire_block_model",
    "path": "assets/sapphire-live/models/block/sapphire_block.json",
    "sha256": "@BLOCK_SHA256@",
    "size_bytes": @BLOCK_SIZE@
  }]
}
