# Local oracle, benchmark and scratch output at any crate depth.
.analysis/

# Vanilla Mojang data files (per ADR 0001) are not redistributed via git.
# They are repopulated locally from .analysis/server.jar by
# tools/extract-vanilla-data.sh. The README and any future schema docs
# stay tracked.
/data/vanilla/data/
/data/vanilla/version.json
/data/vanilla/reports/

# Runtime output, including server subprocesses launched from crate directories.
# Local-only runtime state must never enter source control.
logs/
/world/

# Local Claude / session-scratch dirs (per-session prompt drafts,
# downloaded manifests, harness settings). Not part of the project.
/.claude/
/work/

# Local CodeGraph index. Derived from source; regenerate with `codegraph init`.
/.codegraph/

